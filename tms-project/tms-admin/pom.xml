<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tms</groupId>
    <artifactId>tms-project</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tms-admin</artifactId>
  <name>tms-admin</name>
  <description>启动模块：Spring Boot 入口，聚合全部业务模块；架构红线测试与跨模块集成测试也落在这里（全局唯一的可运行应用，单上下文最快）。</description>

  <dependencies>
    <dependency>
      <groupId>com.tms</groupId>
      <artifactId>tms-framework</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tms</groupId>
      <artifactId>tms-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tms</groupId>
      <artifactId>tms-base</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tms</groupId>
      <artifactId>tms-plan</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tms</groupId>
      <artifactId>tms-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- ⚠ Boot 4 起自动装配按技术拆成了独立模块：光有 org.flywaydb:flyway-core
         不会让 Boot 装配 Flyway（FlywayAutoConfiguration 已不在 spring-boot-autoconfigure 里），
         必须引 org.springframework.boot:spring-boot-starter-flyway。
         配错的表现很有迷惑性：容器照常启动、架构测试照常绿，只有碰库的测试全红。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
